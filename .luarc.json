{
  "runtime.version": "LuaJIT",
  "diagnostics.globals": ["vim"],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "${3rd}/luv/library",
    "${3rd}/busted/library"
  ],
  "workspace.ignoreDir": [
    ".git",
    "node_modules"
  ],
  "format.defaultConfig": {
    "indent_style": "tab",
    "indent_size": "1"
  }
}
