#!/bin/sh
# Pre-push hook: regenerate p5.js reference docs before pushing
# Install with: git config core.hooksPath .githooks

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

echo "==> Pre-push hook: regenerating p5.js docs..."
"$SCRIPT_DIR/scripts/gen-docs.sh"

if [ $? -ne 0 ]; then
  echo "ERROR: Doc generation failed. Push aborted."
  echo "  Fix the issue or run 'git push --no-verify' to skip."
  exit 1
fi

echo "==> Docs are up to date. Proceeding with push."
