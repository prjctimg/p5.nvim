{
  "p5-setup": {
    "prefix": "p5-setup",
    "body": ["function setup() {", "  createCanvas(${1:400}, ${2:400});", "  ${3}", "}"],
    "description": "setup() function skeleton"
  },
  "p5-draw": {
    "prefix": "p5-draw",
    "body": ["function draw() {", "  background(${1:220});", "  ${2}", "}"],
    "description": "draw() function skeleton"
  },
  "p5-preload": {
    "prefix": "p5-preload",
    "body": ["function preload() {", "  ${1}", "}"],
    "description": "preload() function skeleton"
  },
  "p5-sketch": {
    "prefix": "p5-sketch",
    "body": ["function setup() {", "  createCanvas(400, 400);", "}", "", "function draw() {", "  background(220);", "}"],
    "description": "Full p5.js sketch skeleton (setup + draw)"
  },
  "p5-push": {
    "prefix": ["p5-push", "p5-pushpop"],
